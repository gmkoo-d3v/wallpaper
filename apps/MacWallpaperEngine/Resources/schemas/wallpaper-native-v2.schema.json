{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "local.wallpaper.MacWallpaperEngine.schema.wallpaper-native-v2",
  "title": "Mac Wallpaper Engine Native Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runtime",
    "displayPolicy",
    "thermalPolicy",
    "layerBudgets",
    "assets",
    "layers",
    "interactions",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "macos-wallpaper-native.v2" },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "description": { "type": "string" }
      }
    },
    "sourceProvenance": { "$ref": "#/$defs/sourceProvenance" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "targetFps", "maxFps", "fallbackFps", "scheduler"],
      "properties": {
        "kind": { "const": "native-metal" },
        "targetFps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "maxFps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "fallbackFps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "idleRenderFps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "nativeSpinePoseFps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "nativeSpineIdlePoseFps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "physicsIdlePolicy": { "enum": ["dynamic", "sleep-when-idle"] },
        "audioPolicy": { "enum": ["muted", "userControlled", "disabled"] },
        "performanceTiers": {
          "type": "array",
          "items": { "$ref": "#/$defs/performanceTier" }
        },
        "scheduler": { "$ref": "#/$defs/scheduler" }
      }
    },
    "displayPolicy": { "$ref": "#/$defs/displayPolicy" },
    "thermalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nominal", "serious", "critical"],
      "properties": {
        "nominal": { "type": "string", "minLength": 1 },
        "serious": { "type": "string", "minLength": 1 },
        "critical": { "type": "string", "minLength": 1 }
      }
    },
    "layerBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTexturePages",
        "maxTextureDimension",
        "rssTargetMb",
        "rssHardMb",
        "primaryCpuTargetPercent",
        "cpuDowngradePercent",
        "cpuDowngradeWindowSeconds"
      ],
      "properties": {
        "maxTexturePages": { "type": "integer", "minimum": 1 },
        "maxTextureDimension": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "rssTargetMb": { "type": "integer", "minimum": 1 },
        "rssHardMb": { "type": "integer", "minimum": 1 },
        "primaryCpuTargetPercent": { "type": "number", "minimum": 0 },
        "cpuDowngradePercent": { "type": "number", "minimum": 0 },
        "cpuDowngradeWindowSeconds": { "type": "integer", "minimum": 1 }
      }
    },
    "interactionPolicy": { "$ref": "#/$defs/interactionPolicy" },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "staticImage": { "$ref": "#/$defs/staticImageAsset" },
        "video": { "$ref": "#/$defs/videoAsset" },
        "compositeVideo": { "$ref": "#/$defs/videoAsset" },
        "spine": { "$ref": "#/$defs/spineAsset" }
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/layer" }
    },
    "interactions": {
      "type": "array",
      "items": { "$ref": "#/$defs/interaction" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleRootOnly",
        "requirePremultipliedAlpha",
        "requireSpineVersion",
        "rejectUnknownLayerTypes"
      ],
      "properties": {
        "bundleRootOnly": { "type": "boolean" },
        "requirePremultipliedAlpha": { "type": "boolean" },
        "requireSpineVersion": { "type": "string", "minLength": 1 },
        "rejectUnknownLayerTypes": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "sourceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceType"],
      "properties": {
        "sourceType": {
          "enum": [
            "wallpaper-engine-application",
            "wallpaper-engine-scene",
            "wallpaper-engine-web",
            "native",
            "sample",
            "unknown"
          ]
        },
        "sourceRuntime": { "type": "string", "minLength": 1 },
        "projectType": { "type": "string", "minLength": 1 },
        "sourceDescriptors": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/sourceDescriptor" }
        },
        "importedFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "calibratedFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "platformPolicyFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unsupportedFields": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "notes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sourceDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path"],
      "properties": {
        "kind": { "enum": ["wallpaper-engine-project-json", "unity-asset-extraction-manifest", "unity-managed-script-index"] },
        "path": { "type": "string", "minLength": 1 }
      }
    },
    "performanceTier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "targetFps"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "targetFps": { "type": "integer", "minimum": 1, "maximum": 240 },
        "requiresDisplayRefreshHz": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "optIn": { "type": "boolean" },
        "requiresStableStandardTier": { "type": "boolean" },
        "default": { "type": "boolean" }
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxInFlightCommandBuffers", "lateFramePolicy", "catchUp"],
      "properties": {
        "maxInFlightCommandBuffers": { "type": "integer", "minimum": 1, "maximum": 3 },
        "lateFramePolicy": { "enum": ["drop"] },
        "catchUp": { "type": "boolean" }
      }
    },
    "displayPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "secondary", "fullscreenObscured", "occluded"],
      "properties": {
        "primary": { "$ref": "#/$defs/displayRolePolicy" },
        "secondary": { "$ref": "#/$defs/displayRolePolicy" },
        "fullscreenObscured": { "$ref": "#/$defs/displayRolePolicy" },
        "occluded": { "$ref": "#/$defs/displayRolePolicy" }
      }
    },
    "displayRolePolicy": { "enum": ["full", "video-only", "static", "pause"] },
    "interactionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "blockApplicationWindows", "blockDesktopItems"],
      "properties": {
        "mode": { "enum": ["desktop-empty-only", "always", "disabled"] },
        "blockApplicationWindows": { "type": "boolean" },
        "blockDesktopItems": { "type": "boolean" },
        "pointerSmoothing": { "type": "number", "minimum": 0, "maximum": 1 },
        "pointerSampleFps": { "type": "number", "minimum": 15, "maximum": 240 },
        "idleDeadZone": { "type": "number", "minimum": 0, "maximum": 1 },
        "directionSwitchMargin": { "type": "number", "minimum": 0, "maximum": 1 },
        "defaultClickTailSeconds": { "type": "number", "minimum": 0 },
        "releaseFadeSeconds": { "type": "number", "minimum": 0 }
      }
    },
    "staticImageAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "videoAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/relativePath" },
        "playbackRate": { "type": "number", "exclusiveMinimum": 0, "maximum": 4 }
      }
    },
    "spineAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "json", "atlas", "textures", "premultipliedAlpha"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "json": { "$ref": "#/$defs/relativePath" },
        "atlas": { "$ref": "#/$defs/relativePath" },
        "textures": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "premultipliedAlpha": { "type": "boolean" },
        "placement": { "$ref": "#/$defs/spinePlacement" }
      }
    },
    "spinePlacement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "pixelsPerUnit": { "type": "number", "exclusiveMinimum": 0 },
        "cameraPosition": { "$ref": "#/$defs/numberPair" },
        "objectPosition": { "$ref": "#/$defs/numberPair" },
        "objectScale": { "$ref": "#/$defs/numberPair" },
        "orthographicSize": { "type": "number", "exclusiveMinimum": 0 },
        "designAspect": { "type": "number", "exclusiveMinimum": 0 },
        "clipScale": { "type": "number", "exclusiveMinimum": 0 },
        "clipOffset": { "$ref": "#/$defs/numberPair" }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "asset"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "enum": ["static_image", "video", "spine"] },
        "asset": { "type": "string", "minLength": 1 },
        "renderingMode": { "type": "string", "minLength": 1 }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event"],
      "properties": {
        "event": { "enum": ["pointerMove", "pointerDown"] },
        "mapping": { "type": "string", "minLength": 1 },
        "actions": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "neutralPoint": { "$ref": "#/$defs/point" },
        "deadZone": { "$ref": "#/$defs/point" },
        "hitZones": {
          "type": "array",
          "items": { "$ref": "#/$defs/hitZone" }
        },
        "defaultAction": { "$ref": "#/$defs/defaultAction" },
        "buttons": {
          "type": "array",
          "items": { "$ref": "#/$defs/pointerButton" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "event": { "const": "pointerMove" } }, "required": ["event"] },
          "then": { "required": ["mapping", "actions"] }
        },
        {
          "if": { "properties": { "event": { "const": "pointerDown" } }, "required": ["event"] },
          "then": { "anyOf": [{ "required": ["hitZones"] }, { "required": ["defaultAction"] }] }
        }
      ]
    },
    "hitZone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "action"],
      "oneOf": [
        { "required": ["rect"] },
        { "required": ["ellipse"] }
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "rect": {
          "type": "array",
          "prefixItems": [
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 },
            { "type": "number", "minimum": 0, "maximum": 1 }
          ],
          "items": false,
          "minItems": 4,
          "maxItems": 4
        },
        "ellipse": { "$ref": "#/$defs/hitZoneEllipse" },
        "action": { "type": "string", "minLength": 1 },
        "tapAction": { "type": "string", "minLength": 1 },
        "trigger": { "enum": ["tap", "hold"] },
        "tailSeconds": { "type": "number", "minimum": 0 },
        "tapTailSeconds": { "type": "number", "minimum": 0 },
        "holdStartSeconds": { "type": "number", "minimum": 0 },
        "buttons": {
          "type": "array",
          "items": { "$ref": "#/$defs/pointerButton" }
        },
        "priority": { "type": "integer" }
      }
    },
    "hitZoneEllipse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["center", "radiusX", "radiusY"],
      "properties": {
        "center": { "$ref": "#/$defs/point" },
        "radiusX": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "radiusY": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    },
    "defaultAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": { "type": "string", "minLength": 1 },
        "trigger": { "enum": ["tap", "hold"] },
        "tailSeconds": { "type": "number", "minimum": 0 },
        "buttons": {
          "type": "array",
          "items": { "$ref": "#/$defs/pointerButton" }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "pointerButton": { "enum": ["left", "right"] },
    "numberPair": {
      "type": "array",
      "prefixItems": [{ "type": "number" }, { "type": "number" }],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "not": {
        "anyOf": [
          { "pattern": "^/" },
          { "pattern": "^[A-Za-z]:" },
          { "pattern": "(^|/)\\.\\.(/|$)" }
        ]
      }
    }
  }
}
